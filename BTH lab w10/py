from abc import ABC, abstractmethod
from threading import Lock


# ---------------------------------------------------------------------------
# INTERFACE - MÔ HÌNH THIẾT BỊ
# ---------------------------------------------------------------------------
class IDevice(ABC):

    #Bật thiết bị
    @abstractmethod
    def TurnOn(self):
        pass

    #Tắt thiết bị
    @abstractmethod
    def TurnOff(self):
        pass

#Khả năng riêng của cửa: khóa / mở khóa 
class ILockable(ABC):

    #Khoá
    @abstractmethod
    def Lock(self):
        pass

    # MỞ khoá
    @abstractmethod
    def Unlock(self):
        pass

#Đèn thông minh
class SmartLight(IDevice):

    def __init__(self, name: str):
        self.name = name 
        self.is_on = False

    def TurnOn(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def TurnOff(self):
        self.is_on = False
        print(f"{self.name}: OFF")

#Quạt thông minh
class SmartFan(IDevice):

    def __init__(self, name: str):
        self.name = name
        self.is_on = False

    def TurnOn(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def TurnOff(self) -> None:
        self.is_on = False
        print(f"{self.name}: OFF")

#Cửa thông minh
class SmartDoor(IDevice, ILockable):

    def __init__(self, name: str):
        self.name = name
        self.is_on = False
        self.is_locked = False

    def TurnOn(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def TurnOff(self):
        self.is_on = False
        print(f"{self.name}: OFF")

    def Lock(self):
        self.is_locked = True
        print(f"{self.name}: LOCKED")

    def Unlock(self):
        self.is_locked = False
        print(f"{self.name}: UNLOCKED")


# ---------------------------------------------------------------------------
# FACTORY PATTERN
# ---------------------------------------------------------------------------

#client chỉ làm việc với IDevice
class DeviceFactory:
    _registry = {
        "light": SmartLight,
        "fan": SmartFan,
        "door": SmartDoor,
    }

    @staticmethod
    def create(devicetype: str, name: str) -> IDevice:

        key = devicetype.strip().lower()
        cls = DeviceFactory._registry.get(key)
        if cls is None:
            raise ValueError(f"Unsupported device type: {devicetype}")
        return cls(name)

