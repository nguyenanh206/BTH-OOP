from abc import ABC, abstractmethod
from threading import Lock


# ---------------------------------------------------------------------------
# INTERFACE - MÔ HÌNH THIẾT BỊ
# ---------------------------------------------------------------------------
class IDevice(ABC):
    @abstractmethod
    def turn_on(self):
        pass

    @abstractmethod
    def turn_off(self):
        pass


class ILockable(ABC):
    @abstractmethod
    def lock(self):
        pass

    @abstractmethod
    def unlock(self):
        pass


# ---------------------------------------------------------------------------
# CÁC LỚP THIẾT BỊ CỤ THỂ
# ---------------------------------------------------------------------------
class SmartLight(IDevice):
    def __init__(self, name: str):
        self.name = name 
        self.is_on = False

    def turn_on(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def turn_off(self):
        self.is_on = False
        print(f"{self.name}: OFF")


class SmartFan(IDevice):
    def __init__(self, name: str):
        self.name = name
        self.is_on = False

    def turn_on(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def turn_off(self) -> None:
        self.is_on = False
        print(f"{self.name}: OFF")


class SmartDoor(IDevice, ILockable):
    def __init__(self, name: str):
        self.name = name
        self.is_on = False
        self.is_locked = False

    def turn_on(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def turn_off(self):
        self.is_on = False
        print(f"{self.name}: OFF")

    def lock(self):
        self.is_locked = True
        print(f"{self.name}: LOCKED")

    def unlock(self):
        self.is_locked = False
        print(f"{self.name}: UNLOCKED")


# ---------------------------------------------------------------------------
# FACTORY PATTERN
# ---------------------------------------------------------------------------
class DeviceFactory:
    _registry = {
        "light": SmartLight,
        "fan": SmartFan,
        "door": SmartDoor,
    }

    @staticmethod
    def create(device_type: str, name: str) -> IDevice:
        key = device_type.strip().lower()
        cls = DeviceFactory._registry.get(key)
        if cls is None:
            raise ValueError(f"Unsupported device type: {device_type}")
        return cls(name)


# ---------------------------------------------------------------------------
# SINGLETON PATTERN
# ---------------------------------------------------------------------------
class HomeConfiguration:
    _instance = None
    _lock = Lock()

    def __new__(cls):
        with cls._lock:
            if cls._instance is None:
                cls._instance = super(HomeConfiguration, cls).__new__(cls)
                cls._instance._home_name = "My Home"
                cls._instance._night_light_level = 30
        return cls._instance

    @property
    def home_name(self) -> str:
        return self._home_name

    @home_name.setter
    def home_name(self, value: str):
        self._home_name = value

    @property
    def night_light_level(self) -> int:
        return self._night_light_level

    @night_light_level.setter
    def night_light_level(self, value: int):
        self._night_light_level = value


# ---------------------------------------------------------------------------
# FACADE PATTERN
# ---------------------------------------------------------------------------
class SmartHomeFacade:
    def __init__(self, light: IDevice, fan: IDevice, door: ILockable):
        self._light = light
        self._fan = fan
        self._door = door

    def go_to_work(self) -> None:
        self._light.turn_off()
        self._fan.turn_off()
        self._door.lock()

    def go_to_sleep(self) -> None:
        self._fan.turn_off()
        self._door.lock()
        self._light.turn_on()
        # Gọi Singleton trực tiếp qua constructor hoặc định nghĩa classmethod instance()
        level = HomeConfiguration().night_light_level
        print(f"Night light level: {level}%")


# ---------------------------------------------------------------------------
# CHƯƠNG TRÌNH DEMO (MAIN)
# ---------------------------------------------------------------------------
def main() -> None:
    light = DeviceFactory.create("light", "Living room light")
    fan = DeviceFactory.create("FAN", "Living room fan")
    door = DeviceFactory.create("door", "Main door")

    facade = SmartHomeFacade(light, fan, door)
    
    print("--- GoToWork ---")
    facade.go_to_work()
    
    print("\n--- GoToSleep ---")
    facade.go_to_sleep()

    c1, c2 = HomeConfiguration(), HomeConfiguration()
    print("\nSingleton OK:", c1 is c2)


if __name__ == "__main__":
    main()
