from abc import ABC, abstractmethod
from threading import Lock


# ---------------------------------------------------------------------------
# INTERFACE - MÔ HÌNH THIẾT BỊ
# ---------------------------------------------------------------------------
class IDevice(ABC):
    @abstractmethod
    def TurnOn(self):
        pass

    @abstractmethod
    def TurnOff(self):
        pass


class ILockable(ABC):
    @abstractmethod
    def Lock(self):
        pass

    @abstractmethod
    def Unlock(self):
        pass


# ---------------------------------------------------------------------------
# CÁC LỚP THIẾT BỊ CỤ THỂ
# ---------------------------------------------------------------------------
class SmartLight(IDevice):
    def __init__(self, name: str):
        self.name = name 
        self.isOn = False

    def turn_on(self):
        self.isOn = True
        print(f"{self.name}: ON")

    def turn_off(self):
        self.isOn = False
        print(f"{self.name}: OFF")


class SmartFan(IDevice):
    def __init__(self, name: str):
        self.name = name
        self.isOn = False

    def turn_on(self):
        self.isOn = True
        print(f"{self.name}: ON")

    def turn_off(self) -> None:
        self.isOn = False
        print(f"{self.name}: OFF")


class SmartDoor(IDevice, ILockable):
    def __init__(self, name: str):
        self.name = name
        self.isOn = False
        self.isLocked = False

    def TurnOn(self):
        self.isOn = True
        print(f"{self.name}: ON")

    def TurnOff(self):
        self.isOn = False
        print(f"{self.name}: OFF")

    def Lock(self):
        self.isLocked = True
        print(f"{self.name}: LOCKED")

    def Unlock(self):
        self.isLocked = False
        print(f"{self.name}: UNLOCKED")


# ---------------------------------------------------------------------------
# FACTORY PATTERN
# ---------------------------------------------------------------------------
class DeviceFactory:
    _registry = {
        "light": SmartLight,
        "fan": SmartFan,
        "door": SmartDoor,
    }

    @staticmethod
    def Create(deviceType: str, name: str) -> IDevice:
        key = deviceType.strip().lower()
        cls = DeviceFactory._registry.get(key)
        if cls is None:
            raise ValueError(f"Unsupported device type: {deviceType}")
        return cls(name)


# ---------------------------------------------------------------------------
# SINGLETON PATTERN
# ---------------------------------------------------------------------------
class HomeConfiguration:
    _instance = None
    _lock = Lock()

    def __new__(cls):
        with cls._lock:
            if cls._instance is None:
                cls._instance = super(HomeConfiguration, cls).__new__(cls)
                cls._instance._HomeName = "My Home"
                cls._instance._NightLightLevel = 30
        return cls._instance

    @property
    def HomeName(self) -> str:
        return self._HomeName

    @HomeName.setter
    def HomeName(self, value: str):
        self._HomeName = value

    @property
    def NightLightLevel(self) -> int:
        return self._NightLightLevel

    @NightLightLevel.setter
    def NightLightLevel(self, value: int):
        self._NightLightLevel = value


# ---------------------------------------------------------------------------
# FACADE PATTERN
# ---------------------------------------------------------------------------
class SmartHomeFacade:
    def __init__(self, light: IDevice, fan: IDevice, door: ILockable):
        self._light = light
        self._fan = fan
        self._door = door

    def GoToWork(self) -> None:
        self._light.TurnOff()
        self._fan.TurnOff()
        self._door.Lock()

    def GoToSleep(self) -> None:
        self._fan.TurnOff()
        self._door.Lock()
        self._light.TurnOn()
        # Gọi Singleton trực tiếp qua constructor hoặc định nghĩa classmethod instance()
        level = HomeConfiguration().NightLightLevel
        print(f"Night light level: {level}%")


# ---------------------------------------------------------------------------
# CHƯƠNG TRÌNH DEMO (MAIN)
# ---------------------------------------------------------------------------
def main() -> None:
    light = DeviceFactory.Create("light", "Living room light")
    fan = DeviceFactory.Create("FAN", "Living room fan")
    door = DeviceFactory.Create("door", "Main door")

    facade = SmartHomeFacade(light, fan, door)
    
    print("--- GoToWork ---")
    facade.GoToWork()
    
    print("\n--- GoToSleep ---")
    facade.GoToSleep()

    c1, c2 = HomeConfiguration(), HomeConfiguration()
    print("\nSingleton OK:", c1 is c2)


if __name__ == "__main__":
    main()
