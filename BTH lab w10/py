from abc import ABC, abstractmethod
from threading import Lock


# ---------------------------------------------------------------------------
# INTERFACE - MÔ HÌNH THIẾT BỊ
# ---------------------------------------------------------------------------
class IDevice(ABC):

    #Bật thiết bị
    @abstractmethod
    def TurnOn(self):
        pass

    #Tắt thiết bị
    @abstractmethod
    def TurnOff(self):
        pass

#Khả năng riêng của cửa: khóa / mở khóa 
class ILockable(ABC):

    #Khoá
    @abstractmethod
    def Lock(self):
        pass

    # MỞ khoá
    @abstractmethod
    def Unlock(self):
        pass

#Đèn thông minh
class SmartLight(IDevice):

    def __init__(self, name: str):
        self.name = name 
        self.is_on = False

    def TurnOn(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def TurnOff(self):
        self.is_on = False
        print(f"{self.name}: OFF")

#Quạt thông minh
class SmartFan(IDevice):

    def __init__(self, name: str):
        self.name = name
        self.is_on = False

    def TurnOn(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def TurnOff(self) -> None:
        self.is_on = False
        print(f"{self.name}: OFF")

#Cửa thông minh
class SmartDoor(IDevice, ILockable):

    def __init__(self, name: str):
        self.name = name
        self.is_on = False
        self.is_locked = False

    def TurnOn(self):
        self.is_on = True
        print(f"{self.name}: ON")

    def TurnOff(self):
        self.is_on = False
        print(f"{self.name}: OFF")

    def Lock(self):
        self.is_locked = True
        print(f"{self.name}: LOCKED")

    def Unlock(self):
        self.is_locked = False
        print(f"{self.name}: UNLOCKED")


# ---------------------------------------------------------------------------
# FACTORY PATTERN
# ---------------------------------------------------------------------------

#client chỉ làm việc với IDevice
class DeviceFactory:
    _registry = {
        "light": SmartLight,
        "fan": SmartFan,
        "door": SmartDoor,
    }

    @staticmethod
    def create(devicetype: str, name: str) -> IDevice:

        key = devicetype.strip().lower()
        cls = DeviceFactory._registry.get(key)
        if cls is None:
            raise ValueError(f"Unsupported device type: {devicetype}")
        return cls(name)

class ArgumentExcetion(Exception):
    pass


# ---------------------------------------------------------------------------
# SINGLETON PATTERN
# ---------------------------------------------------------------------------

class HomeConfiguration:
# Cấu hình chung của ngôi nhà chỉ có một thể hiện duy nhất

    _instance = None
    _lock = Lock()

    def __new__(cls):
        with cls._lock:
            if cls._instance is None:
                cls._instance = super(HomeConfiguration, cls).__new__(cls)
                cls._instance._HomeName = "My Home"
                cls._instance._NightLightLevel = 30
        return cls._instance

    @property
    def HomeName(self) -> str:
        return self._HomeName

    @HomeName.setter
    def HomeName(self, value: str):
        self._HomeName = value

    @property
    def NightLightLevel(self) -> int:
        return self._NightLightLevel

    @NightLightLevel.setter
    def NightLightLevel(self, value: int):
        self._NightLightLevel = value


# ---------------------------------------------------------------------------
# FACADE
# ---------------------------------------------------------------------------
class SmartHomeFacade:

    def __init__(self, light: IDevice, fan: IDevice, door: ILockable):
        # Chỉ phụ thuộc abstraction, không phụ thuộc lớp cụ thể
        self._light = light
        self._fan = fan
        self._door = door

    def GoToWork(self) -> None:
        self._light.TurnOff()
        self._fan.TurnOff()
        self._door.Lock()

    def GoToSleep(self) -> None:
        self._fan.TurnOff()
        self._door.Lock()
        self._light.TurnOn()
        level = HomeConfiguration.instance().NightLightLevel
        print(f"Night light level: {level}%")


# ---------------------------------------------------------------------------
# Chương trình demo
# ---------------------------------------------------------------------------
def main() -> None:
    light = DeviceFactory.create("light", "Living room light")
    fan = DeviceFactory.create("FAN", "Living room fan")
    door = DeviceFactory.create("door", "Main door")

    facade = SmartHomeFacade(light, fan, door)
    print("--- GoToWork ---")
    facade.go_to_work()
    print("--- GoToSleep ---")
    facade.go_to_sleep()

    c1, c2 = HomeConfiguration.instance(), HomeConfiguration.instance()
    print("Singleton OK:", c1 is c2)


if __name__ == "__main__":
    main()
